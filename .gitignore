# Python
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Env / secrets
.env

# Django
staticfiles/
media/
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
_dgl_extract.json
_parity_*.json

# Datos de apoyo (Fase 4e): los CSV que exportan los PowerShell de static_data/.
# Los SCRIPTS sí se versionan —son código y explican de dónde sale cada dato—, pero los CSV no:
# son un volcado de una base que no es pública, pesan, y se regeneran cuando haga falta.
static_data/csv/

# Las fotos de los peloteros. La CARPETA se versiona (con sus .gitkeep) para que la ruta exista y el
# volumen tenga dónde montarse; las imágenes NO: son de MLB, pesan, y se bajan con
# static_data/scripts/download_mugshots.ps1. La carpeta se monta en el contenedor tal cual.
static/img/mugshots/**/*.png
static/img/mugshots/**/*.jpg

# Lo que sube el editor desde el CMS. La CARPETA se versiona (con su .gitkeep) para que el volumen
# tenga dónde montarse; los archivos NO: son contenido del sitio, no código, y viven en el volumen.
media/*
!media/.gitkeep

# El corredor de pruebas del JavaScript. `package.json` y `package-lock.json` SÍ se versionan —el
# lock es lo que hace reproducible la corrida del CI— pero las dependencias descargadas no.
node_modules/
