# syntax=docker/dockerfile:1
# Imagen de PRODUCCIÓN del sitio. La de desarrollo es `Dockerfile` y no sirve para esto: instala
# `requirements-dev.txt` —167 MB medidos de mypy, pytest, ruff y faker— y arranca `runserver`, que
# es un solo proceso, sin límites y sin nada delante.
#
# Dos etapas para que las herramientas de compilación no viajen a la imagen final.

# ─────────────────────────────────────────────────────────────────────────────────────────────
# Etapa 1: instalar las dependencias
# ─────────────────────────────────────────────────────────────────────────────────────────────
FROM python:3.13-slim AS build

ENV PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt ./
# SOLO las de ejecución. Acá está la diferencia de 167 MB con la imagen de dev.
RUN pip install --upgrade pip && pip install --prefix=/instalado -r requirements.txt

# ─────────────────────────────────────────────────────────────────────────────────────────────
# Etapa 2: la imagen que corre
# ─────────────────────────────────────────────────────────────────────────────────────────────
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod

WORKDIR /app

COPY --from=build /instalado /usr/local

# Las mismas dos carpetas que la imagen de dev, y por la misma razón: Docker copia el contenido Y
# LOS PERMISOS de la carpeta de la imagen al crear un volumen vacío encima. Si acá no existieran, el
# volumen nacería de root y el proceso —que corre como `appuser`— no podría escribir. Se ve como un
# «Permission denied» al guardar la primera imagen del CMS, lejísimos de su causa.
RUN mkdir -p /app/uploads /app/media

COPY . .

# EL uid Y EL gid VAN FIJOS LOS DOS, y el gid no lo estaba: `useradd -r` elegía el que hubiera libre
# en la imagen base y salió 999 de casualidad. Se clava en 999 —el valor que ya está en producción—
# para que una actualización de la imagen base no lo mueva.
#
# Por qué importa tanto un número que parece interno: el VPS corre Docker con `userns-remap`, así que
# las carpetas de datos del anfitrión están chowneadas a `100000+1000 : 100000+999`. Si el gid se
# corriera a 998 en un rebuild, subir imágenes desde el CMS volvería a fallar con «Permission
# denied» — y el despliegue que lo rompiera no tendría NADA que ver con el cambio que lo causó. Ver
# `docs/PRUEBAS_DESPLIEGUE.md`, sección del remapeo de usuarios.
RUN groupadd -r -g 999 appuser \
    && useradd -r -u 1000 -g 999 -m appuser \
    && chown -R appuser:appuser /app
USER appuser

# `collectstatic` EN EL BUILD y no al arrancar. Tres razones: el arranque no debe escribir en disco,
# el resultado es idéntico en cada despliegue, y si falla se entera quien construye y no el sitio a
# las tres de la mañana.
#
# Las variables son de mentira A PROPÓSITO: `collectstatic` no las usa, pero `settings.prod` las
# exige al importarse —falla ruidosamente si faltan, que es lo que se quiere en producción— y en el
# build todavía no hay `.env`. Ninguna queda en la imagen: son de esta capa y de este comando.
RUN DJANGO_SECRET_KEY=solo-para-collectstatic \
    DJANGO_ALLOWED_HOSTS=localhost \
    DATABASE_URL=postgres://x:x@x/x \
    MLB_PROXY_URL=http://x \
    MLB_PROXY_API_KEY=x \
    python manage.py collectstatic --noinput --clear

EXPOSE 8000

# ESTE BLOQUE FIJA CUÁNTAS PETICIONES ATIENDE EL SITIO A LA VEZ. Es el techo de concurrencia, así
# que conviene entender de dónde sale cada número antes de tocarlo.
#
# `--worker-class gthread` y `--threads 4` — EL CAMBIO GRANDE (2026-07-29). Antes eran workers
# SÍNCRONOS: cada uno atiende UNA petición a la vez, así que tres workers eran TRES peticiones
# simultáneas en todo el sitio. Y Django no pasa su tiempo calculando, lo pasa ESPERANDO —a Postgres
# y al proxy de MLB—. Un worker síncrono bloqueado 40 ms esperando a la base es un worker que durante
# esos 40 ms no atiende a nadie más. Con hilos, mientras uno espera otro trabaja.
#
# 4 workers × 4 hilos = **16 peticiones a la vez, contra 3**.
#
# Lo que hace que esto sea seguro y no una fuente de datos corruptos: las dos cachés del proyecto
# aguantan hilos —`LocMemCache` usa un cerrojo y la compartida vive en la base— y Django guarda la
# conexión a Postgres en almacenamiento POR HILO, así que dos hilos nunca comparten un cursor.
#
# `--preload` es lo que MÁS memoria ahorra de todo el despliegue, y es gratis: carga la aplicación
# UNA vez antes de bifurcar, así los ~90 MB de código de Django y Wagtail quedan compartidos entre
# los workers por copy-on-write en vez de duplicados.
#
# Y los hilos son casi gratis en memoria porque comparten el proceso: pasar de 3 a 16 peticiones
# concurrentes cuesta UN worker más, no trece.
#
# 4 workers y no los 9 de la fórmula de manual ((2 x núcleos) + 1): esa fórmula es para saturar CPU,
# y acá el trabajo es esperar E/S. Con 4,8 Gi de RAM y Postgres en el mismo servidor, nueve procesos
# es apretar sin ganar nada.
#
# `--max-requests` recicla cada worker cada 1.000 peticiones. No hay ninguna fuga —medido: +1,1 MB
# tras 270 peticiones y aplanando— pero es el cinturón por si una dependencia gotea con los meses.
# El `jitter` evita que los cuatro se reinicien a la vez y dejen un hueco sin nadie atendiendo.
#
# El timeout en 60s y no en los 30 de defecto: el Backoffice tiene pantallas que comparan CSV de
# miles de filas.
CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--worker-class", "gthread", \
     "--threads", "4", \
     "--preload", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--timeout", "60", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
